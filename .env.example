# Public frontend configuration
# For local development, use the backend running on your machine:
VITE_API_URL=http://localhost:5000/api

# Server-side only. Never expose this key with a VITE_ prefix.
# For Vercel/serverless API routes, configure GEMINI_API_KEY in the hosting provider's environment variables.
GEMINI_API_KEY=replace_with_your_server_side_gemini_key
GEMINI_MODEL=gemini-3.1-flash-lite
